---
interface Props {
	current?: 'pages' | 'variables' | 'configuration';
}

const { current } = Astro.props;
---

<nav class="admin-nav">
	<a href="/admin/pages" class:list={{ active: current === 'pages' }}>Pages</a>
	<a href="/admin/variables" class:list={{ active: current === 'variables' }}>Variables</a>
	<a href="/admin/configuration" class:list={{ active: current === 'configuration' }}>Configuration</a>
</nav>

<style>
	.admin-nav {
		display: flex;
		gap: 1.25rem;
		margin: 1rem 0 1.5rem;
		border-bottom: 1px solid #e5e7eb;
		padding-bottom: 0.75rem;
	}
	.admin-nav a {
		color: #6b7280;
		text-decoration: none;
		font-weight: 600;
		padding-bottom: 0.6rem;
	}
	.admin-nav a.active {
		color: #111827;
		border-bottom: 2px solid #111827;
	}
</style>

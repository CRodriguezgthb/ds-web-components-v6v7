---
export const prerender = false;

import { actions, isInputError } from 'astro:actions';
import Layout from '../../../layouts/Layout.astro';
import AdminNav from '../../../components/AdminNav.astro';
import { createUserClient } from '../../../lib/supabase';

const accessToken = Astro.cookies.get('sb-access-token')?.value;

if (!accessToken) {
	return Astro.redirect('/login');
}

const db = createUserClient(accessToken);

const { data: pages, error } = await db
	.from('pages')
	.select('id, parent_id, title, slug, admin_slug, description')
	.order('title');

const createResult = Astro.getActionResult(actions.pages.create);
const inputErrors = isInputError(createResult?.error) ? createResult.error.fields : {};

// Group into two levels for display. Only top-level pages can be parents, so
// this is the whole tree; see the check constraint note in the init migration.
const topLevel = (pages ?? []).filter((page) => !page.parent_id);
const childrenOf = (parentId: string) => (pages ?? []).filter((page) => page.parent_id === parentId);
---

<Layout title="Pages">
	<main class="pages">
		<header>
			<h1>Pages</h1>
			<a href="/admin">&larr; Volver al dashboard</a>
		</header>
		<AdminNav current="pages" />

		{error && <p class="error">No se pudieron cargar las pages.</p>}
		{createResult?.error && !isInputError(createResult.error) && (
			<p class="error">{createResult.error.message}</p>
		)}
		{Object.keys(inputErrors).length > 0 && (
			<p class="error">{Object.values(inputErrors).flat().join(' ')}</p>
		)}

		<button type="button" id="open-create-page">Nueva page</button>

		<dialog id="create-page-dialog">
			<form method="POST" action={actions.pages.create}>
				<h2>Nueva page</h2>

				<label for="title">Título</label>
				<input type="text" name="title" id="title" required />

				<label for="slug">Slug público</label>
				<input type="text" name="slug" id="slug" required pattern="[a-z0-9-]+" placeholder="mi-page" />

				<label for="parentId">Page padre</label>
				<!--
					Only top-level pages are offered, which keeps the tree two
					levels deep and makes a parent cycle impossible to create
					through the UI.
				-->
				<select name="parentId" id="parentId">
					<option value="">Ninguna (page principal)</option>
					{topLevel.map((page) => <option value={page.id}>{page.title}</option>)}
				</select>

				<label for="description">Descripción</label>
				<textarea name="description" id="description" rows="3"></textarea>

				<div class="actions">
					<button type="button" id="cancel-create-page">Cancelar</button>
					<button type="submit">Crear</button>
				</div>
			</form>
		</dialog>

		{topLevel.length === 0 && <p class="empty">Todavía no hay pages.</p>}

		<ul class="page-list">
			{topLevel.map((page) => (
				<li>
					<div class="page-row">
						<div>
							<strong>{page.title}</strong>
							<a class="slug" href={`/${page.slug}`} target="_blank">/{page.slug}</a>
							{page.description && <p>{page.description}</p>}
						</div>
						<div class="page-actions">
							<a class="manage" href={`/admin/pages/${page.admin_slug}`}>Gestionar</a>
							<form
								method="POST"
								action={actions.pages.remove}
								onsubmit="return confirm('¿Eliminar esta page? También se borran sus subpáginas y componentes.')"
							>
								<input type="hidden" name="id" value={page.id} />
								<button type="submit" class="danger">Eliminar</button>
							</form>
						</div>
					</div>

					{childrenOf(page.id).length > 0 && (
						<ul class="subpage-list">
							{childrenOf(page.id).map((child) => (
								<li class="page-row">
									<div>
										<strong>{child.title}</strong>
										<a class="slug" href={`/${child.slug}`} target="_blank">/{child.slug}</a>
										{child.description && <p>{child.description}</p>}
									</div>
									<div class="page-actions">
										<a class="manage" href={`/admin/pages/${child.admin_slug}`}>Gestionar</a>
										<form
											method="POST"
											action={actions.pages.remove}
											onsubmit="return confirm('¿Eliminar esta subpágina y sus componentes?')"
										>
											<input type="hidden" name="id" value={child.id} />
											<button type="submit" class="danger">Eliminar</button>
										</form>
									</div>
								</li>
							))}
						</ul>
					)}
				</li>
			))}
		</ul>
	</main>
</Layout>

<script>
	const dialog = document.getElementById('create-page-dialog') as HTMLDialogElement | null;
	document.getElementById('open-create-page')?.addEventListener('click', () => dialog?.showModal());
	document.getElementById('cancel-create-page')?.addEventListener('click', () => dialog?.close());

	// Derive the slug from the title until the author edits the slug themselves.
	const titleInput = document.getElementById('title') as HTMLInputElement | null;
	const slugInput = document.getElementById('slug') as HTMLInputElement | null;
	let slugTouched = false;
	slugInput?.addEventListener('input', () => {
		slugTouched = true;
	});
	titleInput?.addEventListener('input', () => {
		if (slugTouched || !slugInput || !titleInput) return;
		slugInput.value = titleInput.value
			.toLowerCase()
			.trim()
			.replace(/[^a-z0-9]+/g, '-')
			.replace(/^-+|-+$/g, '');
	});
</script>

<style>
	.pages {
		max-width: 800px;
		margin: 2rem auto;
		padding: 0 1rem;
	}
	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	header a {
		color: #6b7280;
		text-decoration: none;
	}
	.error {
		padding: 0.6rem 0.85rem;
		border-radius: 4px;
		background: #fef2f2;
		border: 1px solid #fecaca;
		color: #b91c1c;
		font-size: 0.875rem;
	}
	.empty {
		color: #6b7280;
	}
	#open-create-page {
		margin-bottom: 1.25rem;
	}
	button {
		padding: 0.5rem 1rem;
		border: 1px solid #111827;
		border-radius: 4px;
		background: #111827;
		color: white;
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	button.danger {
		background: white;
		border-color: #b91c1c;
		color: #b91c1c;
		font-size: 0.8125rem;
		padding: 0.35rem 0.7rem;
	}
	dialog {
		border: 1px solid #e5e7eb;
		border-radius: 8px;
		padding: 1.5rem;
		min-width: 420px;
	}
	dialog h2 {
		margin: 0 0 1rem;
	}
	dialog form {
		display: flex;
		flex-direction: column;
	}
	dialog label {
		font-weight: 600;
		font-size: 0.875rem;
		margin-top: 0.9rem;
		margin-bottom: 0.25rem;
	}
	dialog input,
	dialog select,
	dialog textarea {
		padding: 0.5rem;
		border: 1px solid #d1d5db;
		border-radius: 4px;
		font: inherit;
	}
	dialog .actions {
		display: flex;
		justify-content: flex-end;
		gap: 0.6rem;
		margin-top: 1.5rem;
	}
	dialog .actions button[type='button'] {
		background: white;
		color: #111827;
		border-color: #d1d5db;
	}
	.page-list,
	.subpage-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.page-list {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.page-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.7rem 1rem;
		border: 1px solid #e5e7eb;
		border-radius: 6px;
	}
	.page-row p {
		margin: 0.25rem 0 0;
		color: #6b7280;
		font-size: 0.875rem;
	}
	.slug {
		display: block;
		color: #6b7280;
		font-size: 0.8125rem;
		text-decoration: none;
	}
	.page-actions {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		flex-shrink: 0;
	}
	.manage {
		color: #111827;
		font-size: 0.875rem;
		font-weight: 600;
	}
	/* Subpages are indented and marked with a rule, so the hierarchy reads at
	   a glance without needing a disclosure control. */
	.subpage-list {
		margin: 0.5rem 0 0 1.75rem;
		padding-left: 0.75rem;
		border-left: 2px solid #e5e7eb;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
</style>
